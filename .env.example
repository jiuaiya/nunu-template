APP_ENV=local
APP_NAME=saas-service
APP_HTTP_ADDR=:8080
APP_HTTP_READ_HEADER_TIMEOUT=5s
APP_HTTP_READ_TIMEOUT=15s
APP_HTTP_WRITE_TIMEOUT=30s
APP_HTTP_IDLE_TIMEOUT=60s
APP_HTTP_SHUTDOWN_TIMEOUT=10s
APP_HTTP_MAX_BODY_BYTES=1048576

APP_MYSQL_DSN=foundation:foundation@tcp(127.0.0.1:23306)/foundation?charset=utf8mb4&parseTime=true&loc=UTC
APP_MYSQL_MAX_OPEN_CONNS=30
APP_MYSQL_MAX_IDLE_CONNS=10
APP_MYSQL_CONN_MAX_LIFETIME=30m

APP_REDIS_ENABLED=true
APP_REDIS_ADDR=127.0.0.1:26379
APP_REDIS_PASSWORD=
APP_REDIS_DB=0

APP_METRICS_ENABLED=true
